<section id="education" class="section">
  <h2 class="section-title">{{t "education"}}</h2>

  <div class="education-list">
    {{#each education.groups}}
    {{#each degrees}}
    <div class="education-item">
      <div class="education-date">{{dateRange date}}</div>
      <div class="education-content">
        <span class="education-degree">{{title}}</span>
        <span class="early-career-separator">·</span>
        <span class="education-institution">{{../institution}}</span>
        {{#if ../location}}
        <span class="education-location">{{../location}}</span>
        {{/if}}
      </div>
    </div>
    {{/each}}
    {{/each}}

    {{#each education.singles}}
    <div class="education-item">
      <div class="education-date">{{dateRange date}}</div>
      <div class="education-content">
        <span class="education-degree">{{title}}</span>
        <span class="early-career-separator">·</span>
        <span class="education-institution">{{institution}}</span>
        {{#if location}}
        <span class="education-location">{{location}}</span>
        {{/if}}
      </div>
    </div>
    {{/each}}
  </div>
</section>
