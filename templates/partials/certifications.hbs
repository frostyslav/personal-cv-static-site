<section id="certifications" class="section">
  <h2 class="section-title">Certifications</h2>

  <div class="cert-grid">
    {{#each certifications}}
    {{#each certs}}
    <a href="{{safeUrl href}}" target="_blank" rel="noopener noreferrer" class="certification-item">
      <img src="{{image}}" alt="" loading="lazy" class="certification-logo" />
      <div class="certification-content">
        <span class="certification-title">{{title}}</span>
        <span class="certification-date">Issued: {{dateRange issued}}</span>
      </div>
      <span class="certification-link-icon" aria-hidden="true">↗</span>
    </a>
    {{/each}}
    {{/each}}
  </div>
</section>
