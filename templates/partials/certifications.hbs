<section id="certifications" class="section">
  <h2 class="section-title">Certifications</h2>

  {{#each certifications}}
  <div class="cert-group {{cssClass}}">
    <h4 class="cert-group-title">{{group}}</h4>
    <div class="cert-group-grid">
      {{#each certs}}
      <a href="{{{href}}}" target="_blank" rel="noopener noreferrer" class="certification-card">
        <img src="{{image}}" alt="{{alt}}" loading="lazy" class="certification-logo" />
        <div class="certification-content">
          <h3 class="certification-title">{{title}}</h3>
          <span class="certification-date">Issued: {{issued}}</span>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
  {{/each}}
</section>
