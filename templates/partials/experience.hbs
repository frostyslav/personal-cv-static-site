<section id="experience" class="section">
  <h2 class="section-title">Experience</h2>

  {{#each experience.groups}}
  <div class="timeline-item company-group">
    <div class="timeline-date">{{date}}</div>
    <p class="timeline-company">{{company}}</p>
    <h3 class="company-position">{{title}}</h3>
    <p class="timeline-location">{{location}}</p>

    <div class="position-timeline">
      {{#each positions}}
      <div class="position-item">
        <div class="position-date">{{date}}</div>
        <h3 class="timeline-title">{{title}}</h3>
        <p class="timeline-project">Project: {{project}}</p>

        <div class="experience-section">
          <h4 class="experience-section-title">Project Overview</h4>
          <p class="timeline-description">{{overview}}</p>
        </div>

        <div class="experience-section">
          <h4 class="experience-section-title">Team Focus</h4>
          <p class="timeline-description">{{teamFocus}}</p>
        </div>

        <div class="experience-section">
          <h4 class="experience-section-title">Role Focus</h4>
          <p class="timeline-description">{{roleFocus}}</p>
        </div>

        <div class="experience-section">
          <h4 class="experience-section-title">Results & Impact</h4>
          <ul class="timeline-description">
            {{#each results}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/each}}

  {{#each experience.singles}}
  <div class="timeline-item">
    <div class="timeline-date">{{date}}</div>
    <p class="timeline-company">{{company}}</p>
    <h3 class="timeline-title">{{title}}</h3>
    <p class="timeline-location">{{location}}</p>
    {{#if project}}
    <p class="timeline-project">Project: {{project}}</p>
    {{/if}}

    <div class="experience-section">
      <h4 class="experience-section-title">Project Overview</h4>
      <p class="timeline-description">{{overview}}</p>
    </div>

    <div class="experience-section">
      <h4 class="experience-section-title">Team Focus</h4>
      <p class="timeline-description">{{teamFocus}}</p>
    </div>

    <div class="experience-section">
      <h4 class="experience-section-title">Role Focus</h4>
      <p class="timeline-description">{{roleFocus}}</p>
    </div>

    <div class="experience-section">
      <h4 class="experience-section-title">Results & Impact</h4>
      <ul class="timeline-description">
        {{#each results}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
  {{/each}}
</section>
