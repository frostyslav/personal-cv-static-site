<section id="experience" class="section">
  <h2 class="section-title">{{t "experience"}}</h2>

  {{#each experience.groups}}
  <div class="timeline-item company-group">
    <div class="timeline-date">{{dateRange date}}</div>
    <p class="timeline-company">{{company}}</p>
    <h3 class="company-position">{{title}}</h3>
    <p class="timeline-location">{{location}}</p>

    <div class="position-timeline">
      {{#each positions}}
      <div class="position-item">
        <div class="position-date">{{dateRange date}}</div>
        <h4 class="timeline-title">{{title}}</h4>
        <p class="timeline-project">{{t "project"}} {{project}}</p>

        {{#if technologies}}
        <ul class="tech-tags" aria-label="{{t "technologiesUsed"}}">
          {{#each technologies}}
          <li class="tech-tag">{{this}}</li>
          {{/each}}
        </ul>
        {{/if}}

        {{#if links}}
        <ul class="project-links" aria-label="Related links">
          {{#each links}}
          <li><a href="{{url}}" target="_blank" rel="noopener noreferrer"><i class="{{linkIcon url}}"></i> {{label}}</a></li>
          {{/each}}
        </ul>
        {{/if}}

        <div class="experience-section">
          <h5 class="experience-section-title">{{t "projectOverview"}}</h5>
          <p class="timeline-description">{{overview}}</p>
        </div>

        <div class="experience-section">
          <h5 class="experience-section-title">{{t "teamFocus"}}</h5>
          <p class="timeline-description">{{teamFocus}}</p>
        </div>

        <div class="experience-section">
          <h5 class="experience-section-title">{{t "roleFocus"}}</h5>
          <p class="timeline-description">{{roleFocus}}</p>
        </div>

        <div class="experience-section experience-results">
          <h5 class="experience-section-title">{{t "resultsImpact"}}</h5>
          <ul class="timeline-description">
            {{#each results}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/each}}

  {{#each experience.singles}}
  <div class="timeline-item{{#if printHide}} print-hide{{/if}}">
    <div class="timeline-date">{{dateRange date}}</div>
    <p class="timeline-company">{{company}}</p>
    <h3 class="timeline-title">{{title}}</h3>
    <p class="timeline-location">{{location}}</p>
    {{#if project}}
    <p class="timeline-project">{{t "project"}} {{project}}</p>
    {{/if}}

    {{#if technologies}}
    <ul class="tech-tags" aria-label="{{t "technologiesUsed"}}">
      {{#each technologies}}
      <li class="tech-tag">{{this}}</li>
      {{/each}}
    </ul>
    {{/if}}

    {{#if links}}
    <ul class="project-links" aria-label="Related links">
      {{#each links}}
      <li><a href="{{url}}" target="_blank" rel="noopener noreferrer"><i class="{{linkIcon url}}"></i> {{label}}</a></li>
      {{/each}}
    </ul>
    {{/if}}

    <div class="experience-section">
      <h4 class="experience-section-title">{{t "projectOverview"}}</h4>
      <p class="timeline-description">{{overview}}</p>
    </div>

    <div class="experience-section">
      <h4 class="experience-section-title">{{t "teamFocus"}}</h4>
      <p class="timeline-description">{{teamFocus}}</p>
    </div>

    <div class="experience-section">
      <h4 class="experience-section-title">{{t "roleFocus"}}</h4>
      <p class="timeline-description">{{roleFocus}}</p>
    </div>

    <div class="experience-section experience-results">
      <h4 class="experience-section-title">{{t "resultsImpact"}}</h4>
      <ul class="timeline-description">
        {{#each results}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
  {{/each}}

  {{#if experience.earlyCareer}}
  <div class="early-career">
    <h3 class="early-career-title">{{t "earlierCareer"}}</h3>
    <div class="early-career-list">
      {{#each experience.earlyCareer}}
      <div class="early-career-item">
        <div class="early-career-date">{{dateRange date}}</div>
        <div class="early-career-content">
          <span class="early-career-role">{{title}}</span>
          <span class="early-career-separator">·</span>
          <span class="early-career-company">{{company}}</span>
          {{#if location}}
          <span class="early-career-location">{{location}}</span>
          {{/if}}
          {{#if description}}
          <p class="early-career-description">{{description}}</p>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}
</section>
