<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{sidebar.profile.name}} - {{sidebar.profile.title}}</title>
    <meta
      name="description"
      content="CV of {{sidebar.profile.name}} — {{sidebar.profile.title}} with {{yearsSince site.careerStartYear}}+ years of expertise in DevOps, cloud migration, and infrastructure. AWS, Azure, GCP certified."
    />
    <meta property="og:title" content="{{sidebar.profile.name}} — {{sidebar.profile.title}}" />
    <meta
      property="og:description"
      content="Professional CV — {{yearsSince site.careerStartYear}}+ years in DevOps, cloud architecture, and infrastructure. Multi-cloud certified (AWS, Azure, GCP, Kubernetes)."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{site.baseUrl}}/" />
    <meta property="og:image" content="{{sidebar.profile.photo.png}}" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{sidebar.profile.name}} — {{sidebar.profile.title}}" />
    <meta
      name="twitter:description"
      content="Professional CV — {{yearsSince site.careerStartYear}}+ years in DevOps, cloud architecture, and infrastructure. Multi-cloud certified (AWS, Azure, GCP, Kubernetes)."
    />
    <meta name="twitter:image" content="{{sidebar.profile.photo.png}}" />
    <meta name="theme-color" content="#2563eb" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none';" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="{{site.baseUrl}}/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <style>
      /* Critical CSS — auto-extracted from source (do not edit manually) */
      @media (prefers-color-scheme:dark){:root:not([data-theme='light']){--primary-color:var(--dark-primary-color);--primary-hover:var(--dark-primary-hover);--primary-light:var(--dark-primary-light);--secondary-color:var(--dark-secondary-color);--text-primary:var(--dark-text-primary);--text-secondary:var(--dark-text-secondary);--text-tertiary:var(--dark-text-tertiary);--gradient-primary-color:var(--dark-gradient-primary);--gradient-secondary-color:var(--dark-gradient-secondary);--bg-primary:var(--dark-bg-primary);--bg-secondary:var(--dark-bg-secondary);--bg-hover:var(--dark-bg-hover);--border-color:var(--dark-border-color);--border-hover:var(--dark-border-hover);--shadow-color:var(--dark-shadow-color);--shadow-primary:var(--dark-shadow-primary);--shadow-primary-lg:var(--dark-shadow-primary-lg);--shadow-primary-sm:var(--dark-shadow-primary-sm)}}@media(max-width:1024px){.content{padding:5rem 2.5rem 2rem}}@media(max-width:1024px){.sidebar{transform:translateX(-100%)}.sidebar.active{transform:translateX(0)}.sidebar-collapse-btn{display:none}.content{margin-left:0;padding:5rem 2rem 2rem}}@media(max-width:768px){.sidebar{position:static;width:100%;height:auto;transform:none;border-right:none;border-bottom:1px solid var(--border-color)}.sidebar.active{transform:none}.content{margin-left:0;padding:2rem 1.5rem}}
    </style>
    <link rel="stylesheet" href="styles.min.css" />
    <link rel="preload" href="{{sidebar.profile.photo.webp}}" as="image" type="image/webp" />
    <link rel="preload" href="vendor/fontawesome/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="vendor/fontawesome/webfonts/fa-brands-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="vendor/fontawesome/css/all.min.css" />
    <noscript>
      <style>
        /* Ensure everything is visible when JS is disabled */
        .section.js-animate { opacity: 1 !important; transform: none !important; }
        .skills-filter-container { display: none; }
        .theme-toggle { display: none; }
        .back-to-top { display: none; }
        .details-toggle { display: none; }
        .collapsible-header .collapse-chevron { display: none; }
        .experience-section.summary-section { display: block !important; }
        .position-item.collapsed .experience-section,
        .position-item.collapsed .timeline-project { display: block !important; }
        .company-collapsed .position-timeline { display: block !important; }
      </style>
    </noscript>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "{{sidebar.profile.name}}",
        "jobTitle": "{{sidebar.profile.title}}",
        "url": "{{site.baseUrl}}/",
        "image": "{{sidebar.profile.photo.png}}",
        "sameAs": [
          {{#each sidebar.social}}{{#if external}}"{{safeUrl href}}"{{#unless @last}},
          {{/unless}}{{/if}}{{/each}}{{#if site.credlyProfileUrl}},
          "{{site.credlyProfileUrl}}"{{/if}}
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "{{experience.groups.[0].company}}"
        },
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "{{education.groups.[0].institution}}"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "{{sidebar.profile.location.city}}",
          "addressCountry": "{{sidebar.profile.location.country}}"
        }
      }
    </script>
  </head>
  <body>
    <a href="#about" class="skip-to-content">Skip to content</a>
    <div class="container">
      {{> sidebar}}

      <button type="button" class="sidebar-collapse-btn" aria-label="Collapse sidebar" aria-expanded="true">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <main class="content">
        <button type="button" class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <section id="about" class="section">
          <h2 class="section-title">About Me</h2>
          {{#each about.paragraphs}}
          <p class="section-text">{{this}}</p>
          {{/each}}
        </section>

        <section id="qualifications" class="section">
          <h2 class="section-title">Core Qualifications</h2>
          <ul class="qualifications-list">
            {{#each about.qualifications}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </section>

        {{> experience}}
        {{> education}}
        {{> skills}}
        {{> certifications}}
      </main>
    </div>

    <button type="button" class="back-to-top" aria-label="Back to top">
      <i class="fa-solid fa-arrow-up"></i>
    </button>

    <div class="print-modal-overlay" id="printModal" role="dialog" aria-modal="true" aria-labelledby="printModalTitle" tabindex="-1" hidden data-pdf-url="{{site.baseUrl}}{{site.cvPdfPath}}">
      <div class="print-modal">
        <h2 id="printModalTitle">Print or Download</h2>
        <p>How would you like to get this CV?</p>
        <div class="print-modal-actions">
          <button type="button" class="btn btn-primary" id="printModalDownload">
            <i class="fa-solid fa-file-pdf"></i> Download PDF
          </button>
          <button type="button" class="btn btn-secondary" id="printModalPrint">
            <i class="fa-solid fa-print"></i> Print Page
          </button>
        </div>
        <button type="button" class="print-modal-close" id="printModalClose" aria-label="Close dialog">
          <i class="fa-solid fa-times"></i>
        </button>
      </div>
    </div>

    <script src="scripts.min.js"></script>
    <script src="sw-register.js"></script>
  </body>
</html>
