<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{sidebar.profile.name}} - {{sidebar.profile.title}}</title>
    <meta
      name="description"
      content="CV of {{sidebar.profile.name}} — {{sidebar.profile.title}} with 15+ years of expertise in DevOps, cloud migration, and infrastructure. AWS, Azure, GCP certified."
    />
    <meta property="og:title" content="{{sidebar.profile.name}} — {{sidebar.profile.title}}" />
    <meta
      property="og:description"
      content="Professional CV — 15+ years in DevOps, cloud architecture, and infrastructure. Multi-cloud certified (AWS, Azure, GCP, Kubernetes)."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cv.rostyslav.eu/" />
    <meta property="og:image" content="{{sidebar.profile.photo.png}}" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{sidebar.profile.name}} — {{sidebar.profile.title}}" />
    <meta
      name="twitter:description"
      content="Professional CV — 15+ years in DevOps, cloud architecture, and infrastructure. Multi-cloud certified (AWS, Azure, GCP, Kubernetes)."
    />
    <meta name="twitter:image" content="{{sidebar.profile.photo.png}}" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="canonical" href="https://cv.rostyslav.eu/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <style>
      /* Critical CSS — inlined to avoid render-blocking */
      *{margin:0;padding:0;box-sizing:border-box}
      :root{--primary-color:#2563eb;--text-primary:#1f2937;--text-secondary:#4b5563;--bg-primary:#ffffff;--bg-secondary:#f9fafb;--border-color:#e5e7eb;--sidebar-width:320px;--transition:all .3s ease;color-scheme:light dark}
      [data-theme='dark']{--primary-color:#3b82f6;--text-primary:#f3f4f6;--text-secondary:#d1d5db;--bg-primary:#1f2937;--bg-secondary:#111827;--border-color:#374151}
      @media(prefers-color-scheme:dark){:root:not([data-theme='light']){--primary-color:#3b82f6;--text-primary:#f3f4f6;--text-secondary:#d1d5db;--bg-primary:#1f2937;--bg-secondary:#111827;--border-color:#374151}}
      body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;line-height:1.6;color:var(--text-primary);background:var(--bg-secondary)}
      .container{display:flex;min-height:100vh}
      .sidebar{width:var(--sidebar-width);background:var(--bg-primary);padding:2rem;display:flex;flex-direction:column;gap:2.5rem;border-right:1px solid var(--border-color);position:fixed;height:100vh;overflow-y:auto;z-index:100}
      .content{flex:1;margin-left:var(--sidebar-width);padding:3rem;max-width:1200px}
      .section{margin-bottom:3.5rem;opacity:1;transform:none}
      .section-title{font-size:2rem;font-weight:800;margin-bottom:1.5rem;color:var(--text-primary);position:relative;padding-bottom:.75rem}
      .section-title::after{content:'';position:absolute;bottom:0;left:0;width:80px;height:3px;background:var(--primary-color)}
      .profile{text-align:center}
      .avatar{width:150px;height:150px;margin:0 auto 1.5rem;border-radius:50%;overflow:hidden;border:4px solid var(--primary-color)}
      .avatar img{width:100%;height:100%;object-fit:cover}
      .name{font-size:1.75rem;font-weight:700;margin-bottom:.5rem;color:var(--text-primary)}
      .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
      .skip-to-content{position:absolute;top:-100%;left:1rem;z-index:9999;padding:.75rem 1.5rem;background:var(--secondary-color);color:var(--bg-secondary);border-radius:0 0 .5rem .5rem;text-decoration:none;font-weight:600;transition:top .2s ease}
      .skip-to-content:focus{top:0}
      @media(max-width:1024px){.sidebar{transform:translateX(-100%)}.content{margin-left:0;padding:5rem 2rem 2rem}}
      @media(max-width:768px){.sidebar{position:static;width:100%;height:auto;transform:none;border-right:none;border-bottom:1px solid var(--border-color)}.content{margin-left:0;padding:2rem 1.5rem}}
    </style>
    <link rel="stylesheet" href="styles.min.css" />
    <link rel="preload" href="vendor/fontawesome/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="vendor/fontawesome/css/all.min.css" /></noscript>
    <noscript>
      <style>
        /* Ensure everything is visible when JS is disabled */
        .section.js-animate { opacity: 1 !important; transform: none !important; }
        .skills-filter-container { display: none; }
        .theme-toggle { display: none; }
        .back-to-top { display: none; }
        .details-toggle { display: none; }
        .collapse-btn { display: none; }
        .company-collapse-btn { display: none; }
        .experience-section.summary-section { display: block !important; }
        .position-item.collapsed .experience-section,
        .position-item.collapsed .timeline-project { display: block !important; }
        .company-collapsed .position-timeline { display: block !important; }
      </style>
    </noscript>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "{{sidebar.profile.name}}",
        "jobTitle": "{{sidebar.profile.title}}",
        "url": "https://cv.rostyslav.eu/",
        "image": "{{sidebar.profile.photo.png}}",
        "sameAs": [
          {{#each sidebar.social}}{{#if external}}"{{safeUrl href}}"{{#unless @last}},
          {{/unless}}{{/if}}{{/each}}
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "{{experience.groups.[0].company}}"
        },
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "{{education.groups.[0].institution}}"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Frankfurt am Main",
          "addressCountry": "DE"
        }
      }
    </script>
  </head>
  <body>
    <a href="#about" class="skip-to-content">Skip to content</a>
    <div class="container">
      {{> sidebar}}

      <button class="sidebar-collapse-btn" aria-label="Collapse sidebar" aria-expanded="true">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <main class="content">
        <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <section id="about" class="section">
          <h2 class="section-title">About Me</h2>
          {{#each about.paragraphs}}
          <p class="section-text">{{this}}</p>
          {{/each}}
        </section>

        <section id="qualifications" class="section">
          <h2 class="section-title">Core Qualifications</h2>
          <ul class="qualifications-list">
            {{#each about.qualifications}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </section>

        {{> experience}}
        {{> education}}
        {{> skills}}
        {{> certifications}}
      </main>
    </div>

    <button class="back-to-top" aria-label="Back to top">
      <i class="fa-solid fa-arrow-up"></i>
    </button>

    <div class="print-modal-overlay" id="printModal" role="dialog" aria-modal="true" aria-labelledby="printModalTitle" tabindex="-1" hidden>
      <div class="print-modal">
        <h2 id="printModalTitle">Print or Download</h2>
        <p>How would you like to get this CV?</p>
        <div class="print-modal-actions">
          <button class="btn btn-primary" id="printModalDownload">
            <i class="fa-solid fa-file-pdf"></i> Download PDF
          </button>
          <button class="btn btn-secondary" id="printModalPrint">
            <i class="fa-solid fa-print"></i> Print Page
          </button>
        </div>
        <button class="print-modal-close" id="printModalClose" aria-label="Close dialog">
          <i class="fa-solid fa-times"></i>
        </button>
      </div>
    </div>

    <script src="scripts.min.js"></script>
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
